# Public website origin. No trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://sarahandjuan.com

# Supabase project API URL and public anon key (Project Settings > API).
# Public values do not grant access to invitation data; migrations deny client access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never add NEXT_PUBLIC_ to these names or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
RSVP_SESSION_SECRET=

# Optional. Leave blank until Sarah and Juan choose the RSVP deadline.
# Once decided, use a complete ISO 8601 timestamp with an explicit offset or Z.
# Example format only: YYYY-MM-DDTHH:mm:ss-07:00
RSVP_DEADLINE=

# Optional test runner setting. Leave unset to let Playwright start the local app.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
